        "properties": {
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "note_id": {
            "type": "string",
            "title": "Note Id"
          },
          "deck_id": {
            "type": "string",
            "title": "Deck Id"
          },
          "deck_name": {
            "type": "string",
            "title": "Deck Name"
          },
          "template_name": {
            "type": "string",
            "title": "Template Name"
          },
          "ord": {
            "type": "integer",
            "title": "Ord"
          },
          "note_type": {
            "$ref": "#/components/schemas/NoteTypeOut"
          },
          "question": {
            "type": "string",
            "title": "Question",
            "description": "Rendered question HTML, as Anki renders it."
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Rendered answer HTML, as Anki renders it."
          }
        },
        "type": "object",
        "required": [
          "card_id",
          "note_id",
          "deck_id",
          "deck_name",
          "template_name",
          "ord",
          "note_type",
          "question",
          "answer"
        ],
        "title": "CardOut"
      },
      "DeckOut": {
        "properties": {
          "deck_id": {
            "type": "string",
            "title": "Deck Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "card_count": {
            "type": "integer",
            "title": "Card Count"
          },
          "is_filtered": {
            "type": "boolean",
            "title": "Is Filtered"
          }
        },
        "type": "object",
        "required": [
          "deck_id",
          "name",
          "card_count",
          "is_filtered"
        ],
        "title": "DeckOut"
      },
      "DeckPage": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
