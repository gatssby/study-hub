        "title": "NoteTypeOut"
      },
      "PatchNoteRequest": {
        "properties": {
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 50,
            "title": "Fields"
          },
          "add_tags": {
            "items": {
              "type": "string",
              "pattern": "^[^\\s\\x00-\\x1f]{1,100}$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Add Tags"
          },
          "remove_tags": {
            "items": {
              "type": "string",
              "pattern": "^[^\\s\\x00-\\x1f]{1,100}$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Remove Tags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PatchNoteRequest"
      },
      "PatchNoteResult": {
        "properties": {
          "note_id": {
            "type": "string",
            "title": "Note Id"
          },
          "updated_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Updated Fields"
          },
          "added_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Added Tags"
          },
          "removed_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Removed Tags"
          },
          "sync": {
            "$ref": "#/components/schemas/PatchSyncState"
