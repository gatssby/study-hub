[Unit]
Description=Study Hub Federal Online scheduled acoustic evidence review
After=study-hub-fo-transcription.service network-online.target
ConditionPathExists=/etc/study-hub/fo-transcription.authorized
ConditionPathExists=/etc/study-hub/fo-vps.marker

[Service]
Type=notify
NotifyAccess=main
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/study-hub/federal-online
EnvironmentFile=/home/ubuntu/.config/study-hub/transcription.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStart=/home/ubuntu/study-hub-models/fo-parakeet-int8/venv/bin/python -m fo_hub.acoustic_service --runtime /home/ubuntu/study-hub-models/fo-parakeet-int8
TimeoutStartSec=52min
RuntimeMaxSec=300s
TimeoutStopSec=15s
KillMode=control-group
Restart=no
CPUQuota=50%
MemoryMax=3G
MemorySwapMax=0
TasksMax=64
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/study-hub-state/federal-online/transcripts/acoustic-review /home/ubuntu/study-hub-state/federal-online/locks /home/ubuntu/.config/rclone
