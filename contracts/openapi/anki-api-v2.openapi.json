        "title": "PatchNoteResult"
      },
      "PatchSyncState": {
        "properties": {
          "before": {
            "type": "string",
            "title": "Before"
          },
          "after": {
            "type": "string",
            "title": "After"
          }
        },
        "type": "object",
        "required": [
          "before",
          "after"
        ],
        "title": "PatchSyncState"
      },
      "SearchPage": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "kind": {
            "type": "string",
            "enum": [
              "notes",
              "cards"
            ],
            "title": "Kind"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          },
          "items": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "query",
          "kind",
          "total",
          "limit",
          "offset",
          "has_more",
          "items"
        ],
        "title": "SearchPage"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query"
          },
          "kind": {
            "type": "string",
            "enum": [
              "notes",
              "cards"
            ],
            "title": "Kind"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 50
          },
          "offset": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "kind"
        ],
        "title": "SearchRequest"
      },
      "SyncRequest": {
        "properties": {
          "media": {
            "type": "boolean",
            "title": "Media",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SyncRequest"
      },
      "SyncResult": {
        "properties": {
          "collection": {
            "type": "string",
            "title": "Collection"
          },
          "media": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
