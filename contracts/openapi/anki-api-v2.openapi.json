        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "anki_version": {
            "type": "string",
            "title": "Anki Version"
          },
          "collection_open": {
            "type": "boolean",
            "title": "Collection Open"
          },
