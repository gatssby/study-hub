        "properties": {
          "note_id": {
            "type": "string",
            "title": "Note Id"
          },
          "note_type": {
            "$ref": "#/components/schemas/NoteTypeOut"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldOut"
            },
            "type": "array",
            "title": "Fields"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "card_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Card Ids"
          },
          "deck_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Deck Ids"
