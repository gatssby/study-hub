[Unit]
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/study-hub/federal-online
EnvironmentFile=/home/ubuntu/.config/study-hub/runtime.env
Environment=TRANSCRIPTION_ENABLED=false
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/home/ubuntu/study-hub-state/federal-online/tmp
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/study-hub-state/federal-online /home/ubuntu/.config/study-hub /home/ubuntu/.config/rclone
CPUQuota=25%
MemoryMax=512M
TasksMax=32
Type=oneshot
ExecStart=/usr/bin/flock -n -E 75 /home/ubuntu/study-hub-state/federal-online/locks/index.lock /home/ubuntu/study-hub-venv/bin/python -m fo_hub.ocr
SuccessExitStatus=75
TimeoutStartSec=5min
Nice=15
IOSchedulingClass=idle
