          },
          "last_media_sync_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Media Sync At"
          },
          "media_sync": {
            "$ref": "#/components/schemas/MediaSyncOut"
          }
        },
        "type": "object",
        "required": [
          "status",
          "api_version",
          "anki_version",
          "collection_open",
          "notes",
          "cards",
          "decks",
          "media_count",
          "sync_state",
          "last_collection_sync_at",
          "last_media_sync_at",
          "media_sync"
        ],
        "title": "HealthOut"
      },
