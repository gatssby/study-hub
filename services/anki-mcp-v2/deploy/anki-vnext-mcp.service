# /etc/systemd/system/anki-vnext-mcp.service
# Local-only Anki MCP v2. The API v2 remains the sole owner of the collection.

[Unit]
Description=Anki GPT MCP v2 (local API v2 adapter)
After=network-online.target anki-vnext-api.service
Wants=network-online.target anki-vnext-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/anki-vnext/mcp/src
EnvironmentFile=/home/ubuntu/anki-vnext/api/api.env
Environment=ANKI_MCP_V2_HOST=127.0.0.1
Environment=ANKI_MCP_V2_PORT=8771
ExecStart=/home/ubuntu/anki-vnext/mcp/.venv/bin/python -m anki_mcp_v2
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
